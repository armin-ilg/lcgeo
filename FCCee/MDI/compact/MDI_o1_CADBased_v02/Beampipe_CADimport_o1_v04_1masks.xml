    <detector name="Beampipe_STL" type="DD4hep_TestShape_Creator">
      <check>
        <shape type="CAD_MultiVolume" ref="${K4GEO}/FCCee/MDI/compact/stl_files/Pipe_240430/AlBeMet162_30042024.stl"
	       unit="mm" material="AlBeMet162">
