<!-- Changes :
   o4_v04 : scaled version of the CLIC VTX Barrel (CLIC_04_v11); distance between sensitive layers in double layers are set to 1*mm and is similar in all 3 layers
-->

<lccdd>
    <define>
        <constant name="Vertex_half_length" value="302*mm"/> <comment> Copied from CLD </comment>
    </define>

    <comment>Tracking detectors</comment>
    <detectors>
       <!-- The envelope consists of a tube generally surrounding the vertex barrel and endcap disks, subtracted by a
            cone describing the upper acceptance of the LumiCal, about 110 mrad in this version of the detector.
       -->
        <detector name="Vertex" type="DD4hep_SubdetectorAssembly" vis="VXDVis">
            <shape type="Polycone" material="Air">
              <zplane z="-Vertex_half_length"  rmin="VertexClearanceTheta * Vertex_half_length" rmax="VTX_r_max" />
 
              <!-- <zplane z="-(111 * mm)"          rmin="VTX_r_min + 0.5*55"                  rmax="VTX_r_max" /> -->
              <!-- <zplane z="+(111 * mm)"          rmin="VTX_r_min + 0.5*55"                  rmax="VTX_r_max" /> -->
 
              <zplane z="-(111 * mm)"          rmin="VTX_r_min"                  rmax="VTX_r_max" />
              <zplane z="+(111 * mm)"          rmin="VTX_r_min"                  rmax="VTX_r_max" />
              <zplane z="+Vertex_half_length"  rmin="VertexClearanceTheta * Vertex_half_length" rmax="VTX_r_max" />
	    </shape>

            <comment>Vertex Assembly</comment>
            <composite name="VertexBarrel_assembly"/>
            <composite name="VertexEndcap"/>
            <composite name="VertexVerticalCable"/>
        </detector>
    </detectors>

    <display>
        <vis name="SiVertexModuleVis"    alpha="1.0" r="1" g="1"    b="0.6"     showDaughters="true"  visible="false"/>
        <vis name="SiVertexSensitiveVis" alpha="1.0" r="1" g="0.2"  b="0.2"     showDaughters="true"  visible="true"/>
        <vis name="SiVertexPassiveVis"   alpha="1.0" r="0.274" g="0.274"  b="0.274"       showDaughters="true"  visible="true"/>
        <vis name="SiVertexCableVis"     alpha="1.0" r="0.85" g="0.53"    b="0.4"       showDaughters="true"  visible="true"/>
        <vis name="FlexVis"              alpha="1.0" r="0.0" g="1"        b="0.4"       showDaughters="true"  visible="true"/>
        <vis name="KaptonVis"            alpha="1.0" r="1.0" g="191/255"    b="0.0"       showDaughters="true"  visible="true"/>
        <vis name="CarbonVis"            alpha="1.0" r="0.0" g="0.0"     b="0.4"       showDaughters="true"  visible="true"/>
        <vis name="VTXSensitiveVis"      alpha="1.0" r="1.0"     g="1.0"     b="0.0"   showDaughters="true"  visible="true"/>
        <vis name="VTXPeripheryVis"      alpha="1.0" r="200/255" g="254/255" b="0.0"   showDaughters="true"  visible="true"/>    
        <vis name="VTXSupportRingVis"    alpha="1.0" r="1.0" g="0.0"      b="0.4"       showDaughters="true"  visible="true"/>
        <vis name="SiVertexAir"          alpha="1.0" r="0" g="0"    b="0"       showDaughters="false"  visible="false"/>
        <vis name="VTXIBTubeVis"  	     alpha="0.8" r="0.25"   	g="0.25"    b="0.2"   showDaughters="true"  visible="true"/>
        <vis name="VTXCarbonFoamVis"     alpha="0.5" r="0.2" 	g="0.2"     b="0.2"   showDaughters="true"  visible="true"/>
    </display>

    <define> <comment> Kapton layer between the beam pipe and the first vertex layer for electrical insulation </comment>
        <constant name="VTXIB_SEED_Kapton_beampipe_thickness" value="0.1*mm"/> 
        <constant name="VTXIB_SEED_Kapton_beampipe_r" value="CentralBeamPipe_rmax+BeamPipeWidth"/> 
        <constant name="VTXIB_SEED_rmin_correction" value="0.15*mm"/>
    </define>

    <define> <comment> Remnants from CLD vertex detector (used for readout cable material and disks) </comment>

    	<constant name="VertexBarrel_r1" value="1.3*cm"/>

        <constant name="VertexEndcap_Sensitive_Thickness"   value="5.000000000e-02*mm"/>
        <constant name="VertexEndcap_Support_Thickness"     value="28.000000000e-02*mm"/> <!-- +50% more material budget as in CLIC VTX -->
        <constant name="VertexEndcap_DoubleLayer_Gap"       value="2.0*mm"/>
        <constant name="VertexEndcap_rmax" value="102*mm"/>
        <constant name="VertexEndcap_z1" value="160*mm"/>
        <constant name="VertexEndcap_z2" value="230*mm"/>
        <constant name="VertexEndcap_z3" value="300*mm"/>
        <constant name="VertexEndcapModules" value="8"/>
	    <constant name="VertexEndcap_rmin1" value="24*mm"/>
        <constant name="VertexEndcap_rmin2" value="34.5*mm"/>
        <constant name="VertexEndcap_rmin3" value="45*mm"/>
        <constant name="VertexEndcapModuleThickness" value="1.22*mm"/>
        <constant name="VertexEndcapOverlap" value="0*mm"/>
    </define>

    <define> <comment> FCC-SEED inner vertex sensor properties </comment>
        <constant name="VTXIB_SEED_sensor_phi_sensitive" value="19.0*mm"/>
        <constant name="VTXIB_SEED_sensor_phi_periphery" value="2.0*mm"/>
        <constant name="VTXIB_SEED_sensor_phi" value="VTXIB_SEED_sensor_phi_sensitive+VTXIB_SEED_sensor_phi_periphery"/>
        <constant name="VTXIB_SEED_sensor_z_sensitive" value="29.9*mm"/>
        <constant name="VTXIB_SEED_sensor_z_periphery" value="0.100*mm"/>
        <constant name="VTXIB_SEED_sensor_z" value="VTXIB_SEED_sensor_z_sensitive+VTXIB_SEED_sensor_z_periphery"/>

        <constant name="VTXIB_SEED_insensitive_thickness_below"   value="40e-03*mm"/> <comment> Assume 40 µm of insensitive sensor thickness </comment>
        <constant name="VTXIB_SEED_sensitive_thickness"           value="10e-03*mm"/> <comment> Assume 10 µm of sensitive sensor thickness, reflecting epi-layer thickness in TPSCo 65 nm process </comment>
        <constant name="VTXIB_SEED_insensitive_thickness_above"   value="0e-03*mm"/> <comment> Assume no metal layer for powering </comment>
        <constant name="VTXIB_SEED_total_sensor_thickness"        value="VTXIB_SEED_insensitive_thickness_below+VTXIB_SEED_sensitive_thickness+VTXIB_SEED_insensitive_thickness_above"/>

        <comment> Representation of curved sensitive elements by number of trapezoids with flat surface. The more, the more round the sensors are. Multiplies the number of surfaces by this number, careful!
            Use '4' to be able to use conformal tracking. Use '1' to have perfect cylindrical surfaces. </comment>
        <constant name="VTXIB_curved_nsegments" value="10"/> 
        <constant name="VTXIB_curved_tolerance_r" value="0.040*mm"/> <!-- Needed for curved inner vertex as otherwise overlaps would be detected. -->
    </define>

    <define> <comment> FCC-SEED global crucial layer properties innermost positions </comment>
        <constant name="VTXIB_SEED_r1" value="CentralBeamPipe_rmax+BeamPipeWidth+VTXIB_SEED_Kapton_beampipe_thickness+VTXIB_curved_tolerance_r"/>
        <constant name="VTXIB_SEED_r2" value="24.0*mm"/>
        <constant name="VTXIB_SEED_r3" value="36.0*mm"/>
        <constant name="VTXIB_SEED_r4" value="48.0*mm"/>
        <constant name="VTXIB_SEED_r5" value="60.0*mm"/>

        <constant name="VTXIB_SEED_nModules1" value="6"/>
        <constant name="VTXIB_SEED_nModules2" value="8"/>
        <constant name="VTXIB_SEED_nModules3" value="8"/>
        <constant name="VTXIB_SEED_nModules4" value="8"/>
        <constant name="VTXIB_SEED_nModules5" value="8"/>

        <constant name="VTXIB_SEED_staves1" value="4"/>
        <constant name="VTXIB_SEED_staves2" value="8"/>
        <constant name="VTXIB_SEED_staves3" value="12"/>
        <constant name="VTXIB_SEED_staves4" value="16"/>
        <constant name="VTXIB_SEED_staves5" value="20"/>

        <constant name="VTXIB_SEED_half_length1" value="VTXIB_SEED_nModules1*VTXIB_SEED_sensor_z/2."/>
        <constant name="VTXIB_SEED_half_length2" value="VTXIB_SEED_nModules2*VTXIB_SEED_sensor_z/2."/>
        <constant name="VTXIB_SEED_half_length3" value="VTXIB_SEED_nModules3*VTXIB_SEED_sensor_z/2."/>
        <constant name="VTXIB_SEED_half_length4" value="VTXIB_SEED_nModules4*VTXIB_SEED_sensor_z/2."/>
        <constant name="VTXIB_SEED_half_length5" value="VTXIB_SEED_nModules5*VTXIB_SEED_sensor_z/2."/>

        <constant name="VTXIB_SEED_zoffset1" value="0.0*mm"/> 
        <constant name="VTXIB_SEED_zoffset2" value="-0.5*mm"/> <comment> To make sure no gap at theta=90 degrees exists </comment>
        <constant name="VTXIB_SEED_zoffset3" value="+0.5*mm"/>
        <constant name="VTXIB_SEED_zoffset4" value="-0.5*mm"/>
        <constant name="VTXIB_SEED_zoffset5" value="+0.5*mm"/>
    </define>

    <define> <comment> Longeron-like support between two curved sensors ('betweenSensors') and between layers ('betweenLayers') </comment>
        <constant name="Longeron_betweenSensors_thickness" value="1*mm"/>
    </define>

    <define> <comment> Curvature of the curved sensors, not the same as the closest radial position! </comment>
        <constant name="VTXIB_SEED_curvature1" value="VTXIB_SEED_r1+VTXIB_SEED_total_sensor_thickness+Longeron_betweenSensors_thickness+5.*VTXIB_curved_tolerance_r"/>
        <constant name="VTXIB_SEED_curvature2" value="VTXIB_SEED_r2+VTXIB_SEED_total_sensor_thickness+Longeron_betweenSensors_thickness+5.*VTXIB_curved_tolerance_r"/>
        <constant name="VTXIB_SEED_curvature3" value="VTXIB_SEED_r3+VTXIB_SEED_total_sensor_thickness+Longeron_betweenSensors_thickness+5.*VTXIB_curved_tolerance_r"/>
        <constant name="VTXIB_SEED_curvature4" value="VTXIB_SEED_r4+VTXIB_SEED_total_sensor_thickness+Longeron_betweenSensors_thickness+5.*VTXIB_curved_tolerance_r"/>
        <constant name="VTXIB_SEED_curvature5" value="VTXIB_SEED_r5+VTXIB_SEED_total_sensor_thickness+Longeron_betweenSensors_thickness+5.*VTXIB_curved_tolerance_r"/>
    </define>

    <define> <comment> Flex on top of sensor periphery </comment>
        <constant name="Flex_Kapton_thickness"  value="0.200*mm"/>
        <constant name="Flex_Al_thickness"      value="0.050*mm"/>
        <constant name="Flex_total_thickness"   value="Flex_Kapton_thickness + Flex_Al_thickness"/>

        <constant name="Flex_curved_tolerance_r" value="0.3*mm"/> <comment> To avoid overlaps </comment>
        <constant name="Flex_offset_r1" value="VTXIB_SEED_r1-VTXIB_SEED_curvature1+VTXIB_SEED_total_sensor_thickness+VTXIB_curved_tolerance_r+Flex_curved_tolerance_r+Longeron_betweenSensors_thickness"/> 
        <constant name="Flex_offset_r2" value="VTXIB_SEED_r2-VTXIB_SEED_curvature2+VTXIB_SEED_total_sensor_thickness+VTXIB_curved_tolerance_r+Flex_curved_tolerance_r+Longeron_betweenSensors_thickness"/> 
        <constant name="Flex_offset_r3" value="VTXIB_SEED_r3-VTXIB_SEED_curvature3+VTXIB_SEED_total_sensor_thickness+VTXIB_curved_tolerance_r+Flex_curved_tolerance_r+Longeron_betweenSensors_thickness"/>
        <constant name="Flex_offset_r4" value="VTXIB_SEED_r4-VTXIB_SEED_curvature4+VTXIB_SEED_total_sensor_thickness+VTXIB_curved_tolerance_r+Flex_curved_tolerance_r+Longeron_betweenSensors_thickness"/>
        <constant name="Flex_offset_r5" value="VTXIB_SEED_r5-VTXIB_SEED_curvature5+VTXIB_SEED_total_sensor_thickness+VTXIB_curved_tolerance_r+Flex_curved_tolerance_r+Longeron_betweenSensors_thickness"/>

        <constant name="Flex_width"  value="VTXIB_SEED_sensor_phi_periphery"/>

        <constant name="Flex_offset_phi1" value= "-VTXIB_SEED_sensor_phi_periphery/(VTXIB_SEED_curvature1*2*pi)*rad"/>
        <constant name="Flex_offset_phi2" value= "-VTXIB_SEED_sensor_phi_periphery/(VTXIB_SEED_curvature1*2*pi)*rad"/>
        <constant name="Flex_offset_phi3" value= "-VTXIB_SEED_sensor_phi_periphery/(VTXIB_SEED_curvature1*2*pi)*rad"/>
        <constant name="Flex_offset_phi4" value= "-VTXIB_SEED_sensor_phi_periphery/(VTXIB_SEED_curvature1*2*pi)*rad"/>
        <constant name="Flex_offset_phi5" value= "-VTXIB_SEED_sensor_phi_periphery/(VTXIB_SEED_curvature1*2*pi)*rad"/>
    </define>

    <define> <comment> Further longeron properties </comment>
        <constant name="Longeron_betweenSensors_offset_r1" value="VTXIB_SEED_r1-VTXIB_SEED_curvature1+VTXIB_SEED_total_sensor_thickness+VTXIB_curved_tolerance_r"/>
        <constant name="Longeron_betweenSensors_offset_r2" value="VTXIB_SEED_r2-VTXIB_SEED_curvature2+VTXIB_SEED_total_sensor_thickness+VTXIB_curved_tolerance_r"/>
        <constant name="Longeron_betweenSensors_offset_r3" value="VTXIB_SEED_r3-VTXIB_SEED_curvature3+VTXIB_SEED_total_sensor_thickness+VTXIB_curved_tolerance_r"/>
        <constant name="Longeron_betweenSensors_offset_r4" value="VTXIB_SEED_r4-VTXIB_SEED_curvature4+VTXIB_SEED_total_sensor_thickness+VTXIB_curved_tolerance_r"/>
        <constant name="Longeron_betweenSensors_offset_r5" value="VTXIB_SEED_r5-VTXIB_SEED_curvature5+VTXIB_SEED_total_sensor_thickness+VTXIB_curved_tolerance_r"/>
        <constant name="Longeron_betweenLayers_offset_r1" value="Flex_offset_r1+Flex_total_thickness"/>
        <constant name="Longeron_betweenLayers_offset_r2" value="Flex_offset_r2+Flex_total_thickness"/>
        <constant name="Longeron_betweenLayers_offset_r3" value="Flex_offset_r3+Flex_total_thickness"/>
        <constant name="Longeron_betweenLayers_offset_r4" value="Flex_offset_r4+Flex_total_thickness"/>
        <constant name="Longeron_betweenLayers_offset_r5" value="Flex_offset_r5+Flex_total_thickness"/>

        <constant name="Longeron_betweenLayers_thickness1" value="VTXIB_SEED_r2 - VTXIB_SEED_curvature1 - Longeron_betweenLayers_offset_r1 - VTXIB_curved_tolerance_r"/>
        <constant name="Longeron_betweenLayers_thickness2" value="VTXIB_SEED_r3 - VTXIB_SEED_curvature2 - Longeron_betweenLayers_offset_r2 - VTXIB_curved_tolerance_r"/>
        <constant name="Longeron_betweenLayers_thickness3" value="VTXIB_SEED_r4 - VTXIB_SEED_curvature3 - Longeron_betweenLayers_offset_r3 - VTXIB_curved_tolerance_r"/>
        <constant name="Longeron_betweenLayers_thickness4" value="VTXIB_SEED_r5 - VTXIB_SEED_curvature4 - Longeron_betweenLayers_offset_r4 - VTXIB_curved_tolerance_r"/>
    </define>

    <define> <comment> Support rings between the FCC-SEED layers </comment>
        <constant name="Support_ring_length"    value="2.0*mm"/> <comment> Length in z direction </comment>

        <constant name="Support_ring_offset_r" value="VTXIB_SEED_total_sensor_thickness+VTXIB_curved_tolerance_r"/>

        <constant name="Support_ring_width1" value="(VTXIB_SEED_r1+Support_ring_offset_r)/VTXIB_SEED_staves1*2*pi*1.04"/> <comment> '*1.04' to make the four ring pieces connect </comment>
        <constant name="Support_ring_width2" value="(VTXIB_SEED_r2+Support_ring_offset_r)/VTXIB_SEED_staves2*2*pi*1.03"/> <comment> '*1.04' to make the four ring pieces connect </comment>
        <constant name="Support_ring_width3" value="(VTXIB_SEED_r3+Support_ring_offset_r)/VTXIB_SEED_staves3*2*pi*1.02"/> <comment> '*1.04' to make the four ring pieces connect </comment>
        <constant name="Support_ring_width4" value="(VTXIB_SEED_r4+Support_ring_offset_r)/VTXIB_SEED_staves4*2*pi*1.01"/> <comment> '*1.04' to make the four ring pieces connect </comment>

        <constant name="Support_ring_thickness1" value="VTXIB_SEED_r2 - VTXIB_SEED_curvature1 - Support_ring_offset_r"/>
        <constant name="Support_ring_thickness2" value="VTXIB_SEED_r3 - VTXIB_SEED_curvature2 - Support_ring_offset_r"/>
        <constant name="Support_ring_thickness3" value="VTXIB_SEED_r4 - VTXIB_SEED_curvature3 - Support_ring_offset_r"/>
        <constant name="Support_ring_thickness4" value="VTXIB_SEED_r5 - VTXIB_SEED_curvature4 - Support_ring_offset_r"/>

        <constant name="Support_ring_offset_phi1" value= "VTXIB_SEED_sensor_phi_sensitive/2./(2*pi*VTXIB_SEED_curvature1)*2*pi"/>
        <constant name="Support_ring_offset_phi2" value= "VTXIB_SEED_sensor_phi_sensitive/2./(2*pi*VTXIB_SEED_curvature2)*2*pi"/>
        <constant name="Support_ring_offset_phi3" value= "VTXIB_SEED_sensor_phi_sensitive/2./(2*pi*VTXIB_SEED_curvature3)*2*pi"/>
        <constant name="Support_ring_offset_phi4" value= "VTXIB_SEED_sensor_phi_sensitive/2./(2*pi*VTXIB_SEED_curvature4)*2*pi"/>
    </define>

    <define> <comment> Carbon fibre support tube holding the complete inner vertex </comment>
        <constant name="VTXIB_tube_thickness" value="0.2*mm"/> 
        <constant name="VTXIB_tube_r" value="VTXIB_SEED_curvature5+Longeron_betweenSensors_offset_r5+Longeron_betweenSensors_thickness+Flex_offset_r5+Flex_total_thickness+4*VTXIB_curved_tolerance_r"/> 
    </define>

    <!--  Definition of the readout segmentation/definition  -->
    <readouts>
        <readout name="VertexBarrelCollection">
            <id>${GlobalTrackerReadoutID}</id>
        </readout>
        <readout name="VertexEndcapCollection">
            <id>${GlobalTrackerReadoutID}</id>
        </readout>
        <readout name="VertexDummyCollection">    <comment> For supports, should not have any hits but better safe than sorry </comment>
            <id>${GlobalTrackerReadoutID}</id>
        </readout>  
    </readouts>


    <detectors>

        <detector name="VertexBarrel_assembly" type="DD4hep_SubdetectorAssembly" vis="VXDVis">
            <composite name="VertexBarrel"/>
            <composite name="Kapton_on_beampipe"/>
            <composite name="VertexInnerBarrel_tube"/>
        </detector>

        <comment> Inner vertex detector made of overlapping, curved sensors </comment>
        <detector name="VertexBarrel" type="VertexBarrel_detailed_o1_v03" vis="VXDVis" id="DetID_VXD_Barrel" readout="VertexBarrelCollection"  region="VTXBRegion">
            <envelope vis="VXDVis">
                <shape type="Assembly"/>
            </envelope>

            <type_flags type=" DetType_TRACKER + DetType_PIXEL + DetType_VERTEX + DetType_BARREL"/>

            <stave name="VTXIB_SEED_Stave1" r="VTXIB_SEED_curvature1" length="2.*VTXIB_SEED_half_length1-2.*Support_ring_length">
                <sensor name="sensor" thickness="VTXIB_SEED_total_sensor_thickness" material="Silicon">
                    <component sensitive="False" isCurved="true" name="Periphery_phi" vis="VTXPeripheryVis" xmin="0."                              xmax="VTXIB_SEED_sensor_phi_periphery" ymin="-VTXIB_SEED_sensor_z/2." ymax="+VTXIB_SEED_sensor_z/2."/>
                    <component sensitive="True"  isCurved="true" name="Pixel array"   vis="VTXSensitiveVis" xmin="VTXIB_SEED_sensor_phi_periphery" xmax="VTXIB_SEED_sensor_phi" ymin="-VTXIB_SEED_sensor_z/2.+VTXIB_SEED_sensor_z_periphery/2." ymax="+VTXIB_SEED_sensor_z/2.-VTXIB_SEED_sensor_z_periphery/2." sensor_insensitive_thickness_below="VTXIB_SEED_insensitive_thickness_below" thickness="VTXIB_SEED_sensitive_thickness" sensor_insensitive_thickness_above="VTXIB_SEED_insensitive_thickness_above" other_insensitive_thickness_below="VTXIB_SEED_Kapton_beampipe_thickness" other_insensitive_thickness_above="0." nsegments="VTXIB_curved_nsegments"/>
                    <component sensitive="False" isCurved="true" name="Periphery_z1"  vis="VTXPeripheryVis" xmin="VTXIB_SEED_sensor_phi_periphery" xmax="VTXIB_SEED_sensor_phi" ymin="-VTXIB_SEED_sensor_z/2." ymax="-VTXIB_SEED_sensor_z/2.+VTXIB_SEED_sensor_z_periphery/2."/>
                    <component sensitive="False" isCurved="true" name="Periphery_z2"  vis="VTXPeripheryVis" xmin="VTXIB_SEED_sensor_phi_periphery" xmax="VTXIB_SEED_sensor_phi" ymin="+VTXIB_SEED_sensor_z/2.-VTXIB_SEED_sensor_z_periphery/2." ymax="+VTXIB_SEED_sensor_z/2."/>
                </sensor>
            
                <components name="support_longeron_between_sensors" r="Longeron_betweenSensors_offset_r1" length="VTXIB_SEED_half_length1-Support_ring_length">
                    <component sensitive="False" isCurved="true" vis="CarbonVis" material="CarbonFoam" thickness="Longeron_betweenSensors_thickness" width="Flex_width" phi_offset="Flex_offset_phi1"/>
                </components>

                <components name="support_longeron_between_layers" r="Longeron_betweenLayers_offset_r1" length="VTXIB_SEED_half_length1-Support_ring_length">
                    <component sensitive="False" isCurved="true" vis="VTXCarbonFoamVis" material="CarbonFoam" thickness="Longeron_betweenLayers_thickness1" width="VTXIB_SEED_sensor_phi_periphery" phi_offset="Flex_offset_phi1"/>
                </components>

                <components name="flex" r="Flex_offset_r1" length="VTXIB_SEED_half_length1-Support_ring_length">
                    <component sensitive="False" isCurved="true" name="Aluminium"     vis="FlexVis"   material="Aluminum" thickness="Flex_Al_thickness"     width="Flex_width" phi_offset="Flex_offset_phi1"/>
                    <component sensitive="False" isCurved="true" name="Kapton" vis="KaptonVis" material="Kapton"   thickness="Flex_Kapton_thickness" width="Flex_width" phi_offset="Flex_offset_phi1" r="Flex_Al_thickness"/>
                </components>

                <end_z name="support_ring" r="Support_ring_offset_r">
                    <component sensitive="False" isCurved="true" vis="VTXSupportRingVis" material="CarbonFoam" thickness="Support_ring_thickness1" width="Support_ring_width1" length="Support_ring_length" phi_offset="Support_ring_offset_phi1" offset="VTXIB_SEED_r1-VTXIB_SEED_curvature1"/>
                </end_z>
            </stave>

            <stave name="VTXIB_SEED_Stave2" r="VTXIB_SEED_curvature2" length="2.*VTXIB_SEED_half_length2-2.*Support_ring_length">
                <sensor name="sensor" thickness="VTXIB_SEED_total_sensor_thickness" material="Silicon">
                    <component sensitive="False" isCurved="true" name="Periphery_phi" vis="VTXPeripheryVis" xmin="0."                              xmax="VTXIB_SEED_sensor_phi_periphery" ymin="-VTXIB_SEED_sensor_z/2." ymax="+VTXIB_SEED_sensor_z/2."/>
                    <component sensitive="True"  isCurved="true" name="Pixel array"   vis="VTXSensitiveVis" xmin="VTXIB_SEED_sensor_phi_periphery" xmax="VTXIB_SEED_sensor_phi" ymin="-VTXIB_SEED_sensor_z/2.+VTXIB_SEED_sensor_z_periphery/2." ymax="+VTXIB_SEED_sensor_z/2.-VTXIB_SEED_sensor_z_periphery/2." sensor_insensitive_thickness_below="VTXIB_SEED_insensitive_thickness_below" thickness="VTXIB_SEED_sensitive_thickness" sensor_insensitive_thickness_above="VTXIB_SEED_insensitive_thickness_above" other_insensitive_thickness_below="0." other_insensitive_thickness_above="0." nsegments="VTXIB_curved_nsegments"/>
